# Secret used to derive deterministic pseudonyms (HMAC). REQUIRED when RAGKIT_ENV=prod.
PSEUDO_KEY=change-me-to-a-long-random-string
# Only needed when llm.provider = anthropic
ANTHROPIC_API_KEY=
# Optional overrides
RAGKIT_CONFIG=configs/default.yaml
RAGKIT_ENV=dev
LOG_LEVEL=INFO
# Protects /metrics, /v1/traces and /v1/corpus (and is used by the Streamlit app in HTTP mode).
RAGKIT_ADMIN_TOKEN=change-me
# Streamlit HTTP mode: point the UI at the API instead of loading the index in-process.
# RAGKIT_API_URL=http://localhost:8000
# Dev only: include the PSEUDONYMISED query text in telemetry (default: keyed hash + length only).
# RAGKIT_LOG_QUERIES=1
# docker compose
GRAFANA_PASSWORD=change-me
